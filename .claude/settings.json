{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/commit-guard.ps1\"",
            "timeout": 15,
            "statusMessage": "Commit guard: checking for unstaged files..."
          },
          {
            "type": "command",
            "if": "PowerShell(git commit *)",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/commit-guard.ps1\"",
            "timeout": 15,
            "statusMessage": "Commit guard: checking for unstaged files..."
          },
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-push-checks.ps1\"",
            "timeout": 120,
            "statusMessage": "Pre-push: checking branch + working tree..."
          },
          {
            "type": "command",
            "if": "PowerShell(git push *)",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-push-checks.ps1\"",
            "timeout": 120,
            "statusMessage": "Pre-push: checking branch + working tree..."
          }
        ]
      }
    ]
  }
}
