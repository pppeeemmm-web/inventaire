# Copy this file to .env.local and fill in the values.
# Never commit .env.local to git.

# Public — safe to expose to the browser (anon key, no write access)
NEXT_PUBLIC_SUPABASE_URL=https://mcrzsxrcoexnlwmaunte.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Private — server-side only. Used for /c/:token validation and admin operations.
# Get this from Supabase Dashboard → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# R2 storage (Cloudflare, EU jurisdiction)
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET=paintings
R2_VAULT_BUCKET=vault
# EU-jurisdiction buckets use eu.r2.dev, not r2.dev
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxx.eu.r2.dev

# Legacy Supabase storage (kept for backward compat)
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=paintings
