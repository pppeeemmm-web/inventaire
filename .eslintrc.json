{
  "extends": "next/core-web-vitals",
  "plugins": ["pem-i18n"],
  "rules": {
    "pem-i18n/no-hardcoded-jsx-text": "off",
    "pem-i18n/no-silent-catch": "warn"
  },
  "overrides": [
    {
      "files": [
        "app/**/*.{js,jsx,ts,tsx}",
        "components/**/*.{js,jsx,ts,tsx}",
        "hooks/**/*.{ts,tsx}"
      ],
      "rules": {
        "pem-i18n/no-hardcoded-jsx-text": "error"
      }
    },
    {
      "files": [
        "app/atelier/sales/_components/Sales.tsx",
        "app/atelier/pipeline/_components/Pipeline.tsx",
        "app/atelier/production/_components/Production.tsx",
        "components/atelier/FiscalTab.tsx",
        "components/atelier/VaultTab.tsx",
        "components/atelier/ExhibitionsTab.tsx",
        "components/atelier/CurationPanel.tsx",
        "components/atelier/PortfolioTab.tsx",
        "components/atelier/ContactEditorPanel.tsx",
        "components/atelier/WorldMapTab.tsx",
        "app/atelier/inventory/_components/Inventory.tsx",
        "components/atelier/AuditTab.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "tests/**/*"
      ],
      "rules": {
        "pem-i18n/no-hardcoded-jsx-text": "off"
      }
    }
  ]
}
