# Copy this file to .env.local and fill in the values.
# Never commit .env.local to git.

# Public — safe to expose to the browser (anon key, no write access)
NEXT_PUBLIC_SUPABASE_URL=https://mcrzsxrcoexnlwmaunte.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Private — server-side only. Used for /c/:token validation and admin operations.
# Get this from Supabase Dashboard → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional — LAN / phone dev without Google OAuth (middleware signs in on /hub, /atelier, etc.).
# Create a Supabase user (Dashboard → Authentication → Users) with email+password.
# Use the SAME email as your production PEM login if you want to see real field sessions on the phone;
# a throwaway dev@… user has its own empty work_session rows (Journal may still show team days if admin).
# NEVER set these on Vercel/production.
# DEV_AUTO_LOGIN_EMAIL=you@pem.studio
# DEV_AUTO_LOGIN_PASSWORD=your-dev-only-password

# Phone on Wi‑Fi: run `npm run dev`, open the printed `Phone : http://192.168.x.x:3000` URL.
# Do NOT use Google login on LAN unless Supabase → Auth → URL Configuration includes:
#   http://192.168.x.x:3000/**
# (otherwise OAuth returns to production Site URL, e.g. pem.studio)

# Optional — local dev only. Personal access token for `npm run gen:types` (regenerates lib/types/supabase.generated.ts).
# Create at https://supabase.com/dashboard/account/tokens — do not commit .env.local.
# SUPABASE_ACCESS_TOKEN=sbp_...

# R2 storage (Cloudflare, EU jurisdiction)
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET=paintings
R2_VAULT_BUCKET=vault
# EU-jurisdiction buckets use eu.r2.dev, not r2.dev
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxx.eu.r2.dev

# Secret for GET /api/inventory/broadcast/feed and POST .../confirm (Make/n8n — server-side only).
# Send as Authorization: Bearer <secret> or header x-inventory-broadcast-secret: <secret>
INVENTORY_BROADCAST_SECRET=

# Optional — printable /card page email row (server-side; omit to hide email on card)
# PUBLIC_CONTACT_EMAIL=

# Contact URL enrich + business card capture (server-side only)
# CONTACT_ENRICH_LLM=auto|openai|ollama|none
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o-mini
# CONTACT_CARD_VISION=auto|none|openai  # auto = vision when OPENAI_API_KEY set; none = paste-only OCR path
